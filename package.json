{
  "name": "slng-sdks",
  "version": "0.0.0",
  "private": true,
  "description": "Slng unified-API SDKs and CLI monorepo",
  "workspaces": [
    "cli"
  ],
  "scripts": {
    "sync-specs": "bash scripts/sync-specs.sh",
    "sync-voice-tools": "bash scripts/sync-voice-tools.sh",
    "sync-live-models": "bun scripts/sync-live-models.ts",
    "sync-models": "bun scripts/sync-catalog-models.ts",
    "sync-models:check": "bun scripts/sync-catalog-models.ts --check",
    "gen-sdk-catalogs": "bun scripts/gen-sdk-catalogs.ts",
    "gen-ws-types": "bash scripts/gen-ws-types.sh",
    "gen-voices": "bun scripts/gen-voice-catalog.ts",
    "regen": "bun run sync-specs && bun run sync-voice-tools && bun run gen-ws-types && bun run gen-voices && bun run sync-live-models && bun run gen-sdk-catalogs",
    "test": "bun test streaming/ cli/"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "quicktype": "^23.0.171",
    "typescript": "^5.6.0",
    "yaml": "^2.8.4"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "dependencies": {
    "@types/ws": "^8.18.1",
    "ws": "^8.20.0"
  }
}
